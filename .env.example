# Browser-safe project settings. Use local Supabase status values for development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The canonical app origin. Set the exact HTTPS production URL on Vercel.
SITE_URL=http://localhost:3000

# Server-only import/bootstrap credential. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Administrator login alias and initial setup, supplied privately at setup time.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
